<Window
    x:Class="Unlocker.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderThickness="0,0,1,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Padding="24,36" Spacing="18">
                <TextBlock Text="◈  Unlocker Next" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="SYSTEM RECOVERY" FontSize="11" Opacity="0.64" />
                <Border Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="8" Padding="12,10">
                    <TextBlock Text="Ограничения Windows" FontWeight="SemiBold" />
                </Border>
                <TextBlock Text="FOUNDATION · HKCU" FontSize="11" Opacity="0.55" Margin="0,12,0,0" />
                <TextBlock Text="Локальная диагностика. Без сети и постоянных служб."
                           TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Column="1">
            <StackPanel Padding="42,36" Spacing="20" MaxWidth="1050" HorizontalAlignment="Stretch">
                <StackPanel Spacing="7">
                    <TextBlock Text="Диагностика ограничений" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Четыре пользовательские политики Windows. Наличие ограничения само по себе не означает заражение."
                               TextWrapping="Wrap" Opacity="0.73" />
                </StackPanel>
                <InfoBar x:Name="Notice" IsOpen="True" Severity="Informational"
                         Title="Демонстрационная основа"
                         Message="Доступны сканирование, исправление выбранного ограничения и откат. Остальные модули ещё не перенесены." />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="ScanButton" Content="Сканировать" Click="ScanButton_Click" Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="RepairButton" Content="Исправить выбранное" Click="RepairButton_Click" IsEnabled="False" />
                    <Button x:Name="RollbackButton" Content="Откатить последнее" Click="RollbackButton_Click" IsEnabled="False" />
                </StackPanel>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Результаты" FontSize="18" FontWeight="SemiBold" />
                            <ListView x:Name="ResultsList" MinHeight="300" SelectionMode="Single"
                                      SelectionChanged="ResultsList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="4" Padding="6">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StateText}" Opacity="0.7" FontSize="12" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel Spacing="13">
                            <TextBlock Text="Сведения" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="SelectedTitle" Text="Выберите результат" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="SelectedDetails" Text="Никаких изменений до вашего подтверждения."
                                       TextWrapping="Wrap" Opacity="0.75" />
                            <TextBlock Text="Область: HKEY_CURRENT_USER (64-bit view)" TextWrapping="Wrap" FontSize="12" Opacity="0.64" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock x:Name="HistoryText" Text="История восстановления: ещё не загружена"
                           FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
